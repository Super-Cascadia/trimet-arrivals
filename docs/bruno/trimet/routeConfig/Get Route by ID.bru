meta {
  name: Get Route by ID
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/V1/routeConfig/json/true/route/100/dir/true/stops/true/appID/{{appID}}
  body: none
  auth: none
}

docs {
  Fetch route configuration including all stops and directions for a specific route.
  
  Parameters:
  - route: Route ID (e.g., 100 for Blue Line)
  - dir: Include direction information (true/false)
  - stops: Include stop information (true/false)
}
